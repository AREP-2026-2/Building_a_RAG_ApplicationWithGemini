# Create one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Identifies the notebook to Wikipedia when fetching pages (any string is fine).
USER_AGENT=rag-homework/1.0 (educational use)
